# Copia rápida de las claves de Script Properties (Apps Script).
# IMPORTANTE: este archivo NO se lee desde ningún código — sólo sirve para
# copiar/pegar fácil en el editor de Apps Script:
#   Configuración del proyecto → Propiedades de la secuencia de comandos.
# `.env` está en .gitignore: NUNCA se commitea (baseapi §10.2: secretos
# fuera del repositorio).

# ── Manuales (las cargás vos; las verifica setup/00-check-properties) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=
ENV=dev

# ── Generadas por el setup (NO las cargues a mano) ─────────────────────
# SPREADSHEET_ID=       ← lo genera setup/01-setup-spreadsheet
# ADMIN_TOKEN_HASH=     ← lo genera setup/00-check-properties (hash del token)
# SCHEMA_VERSION=       ← lo genera setup/03-setup-drift
